# Copy this file to ".env" and fill in real values. Never commit the real .env file.

# "development" or "production"
DJANGO_ENV=development
# Long random text. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
# Comma-separated host names the backend answers to
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated addresses of the website (frontend)
FRONTEND_ORIGINS=http://localhost:3000

# PostgreSQL
DB_NAME=meriba_lsms
DB_USER=meriba_lsms
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# The shop's local time zone, used to decide the business date
BUSINESS_TIMEZONE=Africa/Dar_es_Salaam
